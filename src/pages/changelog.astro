---
import Base from '../layouts/Base.astro';
import { changelog } from '../data/changelog';
import { siteConfig } from '../site.config';

const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="What’s new" description={`New tools and updates on ${siteConfig.name}.`} image="/og/changelog.png">
  <article class="wrap prose">
    <p class="kicker"><b>Changelog</b></p>
    <h1>What’s new</h1>
    <p class="lede">New tools, more formulas and fixes, newest first.</p>

    <ol class="releases">
      {
        changelog.map((r) => (
          <li class="release">
            <p class="release__meta">
              <span class="tag">v{r.version}</span>
              <time datetime={r.date}>{fmt(r.date)}</time>
            </p>
            <h2>{r.title}</h2>
            <ul>
              {r.changes.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <p>
      Want something added? <a href={siteConfig.feedbackUrl} rel="noopener">Suggest it on GitHub</a>.
    </p>
  </article>
</Base>
