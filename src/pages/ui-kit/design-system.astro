---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import KitThemeHead from '../../components/uikit/KitThemeHead.astro';
import ThemeBuilder from '../../components/uikit/ThemeBuilder';
import { PADDING_KEYS, RADIUS_KEYS, SIZE_KEYS, THICKNESS_KEYS, defaultTheme } from '../../uikit/theme';
import { PREFIXES } from '../../uikit/validate';

const title = 'Design system';
const description =
  'One named formula, fxConfig, holds the colors, fonts, sizes and corners of every UI Kit component. Pick your colors here and copy it into App.Formulas.';

const prefixes = [...new Map(PREFIXES.map((p) => [p.prefix + p.what, p])).values()];
const variables = [
  { prefix: 'fx', what: 'Named formula (App.Formulas)', example: 'fxConfig, fxNavItems, fxSteps' },
  { prefix: 'col', what: 'Collection', example: 'colRequests, colSelectedChips' },
  { prefix: 'gbl', what: 'Global variable (Set)', example: 'gblSelectedItem, gblLoading' },
  { prefix: 'lcl', what: 'Local variable (UpdateContext)', example: 'lclShowConfirm, lclPage' },
  { prefix: 'scr', what: 'Screen', example: 'scrHome, scrDetails' },
  { prefix: 'cmp', what: 'Component', example: 'cmpHeader, cmpSearch' },
];
const examples: Record<string, string> = {
  vCon: 'vConSidebar',
  hCon: 'hConHeader',
  nCon: 'nConConfirmOverlay',
  lbl: 'lblHeaderTitle',
  btn: 'btnAction',
  shp: 'shpTabUnderline',
  ico: 'icoClose',
  img: 'imgSearchIcon',
  txt: 'txtSearch',
  gal: 'galRequests',
};
const t = defaultTheme;
---

<Base title={`${title} · UI Kit`} description={description} image="/og/ui-kit/design-system.png">
  <KitThemeHead slot="head" />
  <div class="wrap wrap--wide">
    <a class="post__back" href="/ui-kit/">← UI Kit</a>
    <PageHead path="~/ui-kit/design-system" title={title} lede={description} />

    <section class="home-section ds-intro" aria-labelledby="ds-how">
      <SectionHead index="01 · use it" title="How it works" id="ds-how" />
      <div class="kit-rules">
        <div>
          <h3>fxConfig holds everything</h3>
          <p>
            <code>ColorConfigs</code> has the colors, <code>TextConfigs</code> the font, sizes, borders, corners and spacing. Two shortcuts,
            <code>fxColorConfigs</code> and <code>fxTextConfigs</code>, keep formulas short.
          </p>
        </div>
        <div>
          <h3>Components only read it</h3>
          <p>
            A button’s Fill is <code>fxColorConfigs.Primary1</code>, its Size <code>fxTextConfigs.Size.Small</code>. Change Primary1 once and every button
            in the app follows.
          </p>
        </div>
        <div>
          <h3>Paste once per app</h3>
          <p>Open App, select <b>Formulas</b>, and paste the code below at the end. Named formulas don’t need OnStart, and they recalculate on their own.</p>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="ds-theme">
      <SectionHead index="02 · colors" title="Make it yours" id="ds-theme" />
      <ThemeBuilder client:load />
    </section>

    <section class="home-section" aria-labelledby="ds-names">
      <SectionHead index="03 · names" title="Naming conventions" id="ds-names" />
      <p class="ds-lede">
        Every control in the kit is named this way, and the site checks it before a snippet is published. A name starts with its prefix, then a capital letter.
        To apply the same rules to your own app, paste its YAML into the <a href="/naming-checker/">Naming Checker</a>.
      </p>
      <div class="ds-tables">
        <table class="ds-table">
          <caption>Controls</caption>
          <thead>
            <tr><th>Prefix</th><th>Control</th><th>Example</th></tr>
          </thead>
          <tbody>
            {
              prefixes.map((p) => (
                <tr>
                  <td><code>{p.prefix}</code></td>
                  <td>{p.what}</td>
                  <td><code>{examples[p.prefix] ?? '-'}</code></td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <table class="ds-table">
          <caption>Formulas, variables and more</caption>
          <thead>
            <tr><th>Prefix</th><th>What</th><th>Example</th></tr>
          </thead>
          <tbody>
            {
              variables.map((v) => (
                <tr>
                  <td><code>{v.prefix}</code></td>
                  <td>{v.what}</td>
                  <td><code>{v.example}</code></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="home-section" aria-labelledby="ds-tokens">
      <SectionHead index="04 · sizes" title="Text and spacing tokens" id="ds-tokens" />
      <div class="ds-tokens">
        <div>
          <h3>fxTextConfigs.Size</h3>
          <ul>{SIZE_KEYS.map((k) => <li><code>{k}</code><span style={`font-size:${Math.min(t.size[k], 24)}pt`}>Aa</span><b>{t.size[k]}</b></li>)}</ul>
        </div>
        <div>
          <h3>fxTextConfigs.Padding</h3>
          <ul>{PADDING_KEYS.map((k) => <li><code>{k}</code><span class="ds-bar" style={`width:${t.padding[k] * 2}px`} /><b>{t.padding[k]}</b></li>)}</ul>
        </div>
        <div>
          <h3>fxTextConfigs.BorderRadius</h3>
          <ul>{RADIUS_KEYS.map((k) => <li><code>{k}</code><span class="ds-corner" style={`border-top-left-radius:${t.radius[k]}px`} /><b>{t.radius[k]}</b></li>)}</ul>
        </div>
        <div>
          <h3>fxTextConfigs.BorderThickness</h3>
          <ul>{THICKNESS_KEYS.map((k) => <li><code>{k}</code><span class="ds-line" style={`height:${Math.max(t.thickness[k], 0)}px`} /><b>{t.thickness[k]}</b></li>)}</ul>
        </div>
      </div>
      <p class="ds-lede">
        Also <code>fxTextConfigs.Font</code> (“{t.font}”) and <code>fxTextConfigs.Height.Singleline</code> ({t.height.Singleline}) and <code>Multiline</code> ({t.height.Multiline}) for inputs.
      </p>
    </section>
  </div>
</Base>
