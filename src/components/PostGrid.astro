---
import { Image } from 'astro:assets';
import { formatDate, postCover, postUrl, readingTime, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  level?: 2 | 3;
}

const { posts, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<ul class="mcards" data-reveal-group>
  {
    posts.map((p) => (
      <li class="mcard">
        <a href={postUrl(p)}>
          <span class="mcard__media">
            {
              p.data.cover ? (
                <Image src={p.data.cover} alt="" widths={[420, 840]} sizes="(max-width: 640px) 100vw, 400px" loading="lazy" />
              ) : (
                <img src={postCover(p)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
              )
            }
            <span class="mcard__badge mcard__badge--end">
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            </span>
            {p.data.draft && <span class="mcard__badge mcard__badge--end mcard__badge--bottom">Draft</span>}
          </span>
          <span class="mcard__body">
            <H class="mcard__title">{p.data.title}</H>
            <span class="mcard__desc">{p.data.description}</span>
            <span class="mcard__meta">
              {readingTime(p.body)} min read{p.data.tags.length > 0 && <> · {p.data.tags.slice(0, 2).join(', ')}</>}
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
