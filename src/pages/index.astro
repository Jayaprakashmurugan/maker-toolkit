---
import Base from '../layouts/Base.astro';
import CodeTicker from '../components/CodeTicker';
import ToolGrid from '../components/ToolGrid.astro';
import { categories, tools, toolsIn } from '../data/tools';
import { desktopReference, powerAppsReference, powerAutomateReference } from '../data/references';
import { siteConfig } from '../site.config';

const tickerLines = [
  { code: `Patch(Tasks, ThisItem, { Status: "Done" })`, note: 'Power Apps: mark the task as done', lang: 'powerfx' as const },
  {
    code: `formatDateTime(convertTimeZone(utcNow(), 'UTC', 'India Standard Time'), 'dd MMM yyyy')`,
    note: 'Power Automate: today in India',
    lang: 'wdl' as const,
  },
  { code: `Filter(Tasks, AssignedTo.Email = User().Email, Status <> "Done")`, note: 'Power Apps: my open tasks', lang: 'powerfx' as const },
  { code: `union(variables('emails'), variables('emails'))`, note: 'Power Automate: remove duplicates', lang: 'wdl' as const },
  { code: `IfError(Value(txtQty.Text), 0)`, note: 'Power Apps: never crash on bad input', lang: 'powerfx' as const },
];

const entries = powerAppsReference.items.length + powerAutomateReference.items.length + desktopReference.items.length;
const toolCount = tools.filter((t) => t.kind === 'tool').length;
const groups = categories.map((c) => ({ ...c, tools: toolsIn(c.id) }));
// Cards are numbered straight through all four groups.
const starts = groups.map((_, i) => 1 + groups.slice(0, i).reduce((n, g) => n + g.tools.length, 0));
const tryThese = ['remove duplicates', 'format date', 'Patch', 'trigger condition', 'email table', 'regex'];

const faqs = [
  {
    q: 'Is it free?',
    a: 'Yes. Every tool runs in your browser. There is no account, no paywall and nothing to install.',
  },
  {
    q: 'Do you collect my data?',
    a: 'No. There are no cookies and no sign-ups. Nothing you type into a tool leaves your device.',
  },
  {
    q: 'Is this an official Microsoft site?',
    a: 'No. It is an independent project. Every reference entry links to the official Microsoft Learn page so you can check the source.',
  },
  {
    q: 'Something is wrong or missing. What do I do?',
    a: `Report it on the issues page linked in the footer. Corrections and suggestions are welcome.`,
  },
];
---

<Base description={siteConfig.description}>
  <section class="wrap hero">
    <p class="kicker reveal" style="--d:0"><b>Field manual</b> · Vol. 01 · Power Platform</p>
    <h1 class="hero__title reveal" style="--d:1">
      <span>Formulas,</span>
      <span class="hero__accent" data-scramble>decoded.</span>
    </h1>

    <div class="hero__grid">
      <div class="reveal" style="--d:3">
        <p class="hero__lede">
          A free toolbox for people who build with Power Apps, Power Automate and Dataverse. Search {entries} formulas
          and expressions, or pick a tool. Everything runs in your browser.
        </p>
        <form class="hero-search" role="search" action="/" data-search-form>
          <label class="visually-hidden" for="hero-q">Search tools, formulas and expressions</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <input id="hero-q" type="search" placeholder="Search tools, formulas, expressions…" autocomplete="off" spellcheck="false" data-search-input />
          <kbd data-search-kbd>Ctrl K</kbd>
        </form>
        <p class="hero-search__try">
          Try
          {
            tryThese.map((q) => (
              <button type="button" class="chip" data-search-query={q}>
                {q}
              </button>
            ))
          }
        </p>
      </div>
      <div class="reveal" style="--d:4">
        <CodeTicker lines={tickerLines} />
      </div>
    </div>

    <dl class="stats reveal" style="--d:5">
      <div><dt>Power Fx formulas</dt><dd data-count>{powerAppsReference.items.length}</dd></div>
      <div><dt>Flow expressions</dt><dd data-count>{powerAutomateReference.items.length}</dd></div>
      <div><dt>Desktop formulas</dt><dd data-count>{desktopReference.items.length}</dd></div>
      <div><dt>Tools</dt><dd data-count>{toolCount}</dd></div>
      <div><dt>Cookies</dt><dd>0</dd></div>
    </dl>
  </section>

  <section class="wrap section" id="tools" aria-labelledby="tools-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">The toolbox</p>
        <h2 id="tools-title">Every tool, by product</h2>
      </div>
      <p>{tools.length} tools and references in four groups. Each one does one job and needs no setup.</p>
    </div>

    <nav class="cat-jump" aria-label="Tool groups" data-reveal>
      {
        groups.map((g) => (
          <a href={`#${g.id}`} style={`--cat:${g.color}`}>
            <span class="tcard__dot" aria-hidden="true" />
            {g.name}
            <span class="cat-jump__n">{g.tools.length}</span>
          </a>
        ))
      }
    </nav>

    {
      groups.map((g, i) => (
        <section class="cat" id={g.id} aria-labelledby={`${g.id}-title`} style={`--cat:${g.color}`}>
          <header class="cat__head" data-reveal>
            <p class="cat__index">{String(i + 1).padStart(2, '0')}</p>
            <h3 id={`${g.id}-title`}>{g.name}</h3>
            <p class="cat__summary">{g.summary}</p>
            <a class="cat__more" href={`/${g.id}/`}>
              All {g.name} tools <span aria-hidden="true">→</span>
            </a>
          </header>
          <ToolGrid tools={g.tools} start={starts[i]} />
        </section>
      ))
    }
  </section>

  <section class="wrap section" aria-labelledby="why-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">How it works</p>
        <h2 id="why-title">Built for the middle of a build</h2>
      </div>
    </div>
    <div class="principles" data-reveal-group>
      <article class="principle">
        <p class="kicker"><b>01</b> · Search</p>
        <h3>Search everything at once</h3>
        <p>Press Ctrl K anywhere and type “remove duplicates” or “format date” to find the formula, expression or tool that does it.</p>
      </article>
      <article class="principle">
        <p class="kicker"><b>02</b> · Copy</p>
        <h3>Copy, paste, done</h3>
        <p>Every syntax line, example and generated formula has a copy button. Paste it straight into the formula bar.</p>
      </article>
      <article class="principle">
        <p class="kicker"><b>03</b> · Private</p>
        <h3>Private by default</h3>
        <p>No accounts, no cookies, no tracking of what you type. It is a plain, fast static site.</p>
      </article>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="faq-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Questions</p>
        <h2 id="faq-title">FAQ</h2>
      </div>
    </div>
    <div class="faq" data-reveal-group>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div>{f.a}</div>
          </details>
        ))
      }
    </div>
  </section>
</Base>
