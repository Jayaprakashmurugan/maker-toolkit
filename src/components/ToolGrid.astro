---
// Equal-weight cards: every tool and reference gets the same size and layout.
import { categoryById, type Tool } from '../data/tools';
import Icon from './Icon.astro';

interface Props {
  tools: Tool[];
  /** Heading level for card titles, so they nest under the section heading. */
  level?: 2 | 3;
}

const { tools, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<ul class="tcards" data-reveal-group>
  {
    tools.map((t) => {
      const cat = categoryById(t.category);
      return (
        <li class="tcard" style={`--cat:${cat.color}`} data-cats={[t.category, ...(t.also ?? [])].join(' ')}>
          <a href={t.href}>
            <span class="tcard__top">
              <span class="tcard__dot" aria-hidden="true" />
              {cat.short}
              <span class="tcard__kind">{t.kind === 'reference' ? 'Reference' : 'Tool'}</span>
            </span>
            <H class="tcard__title">{t.title}</H>
            <span class="tcard__desc">{t.description}</span>
            <span class="tcard__foot">
              <span class="tcard__meta">{t.meta}</span>
              <Icon name="arrow" class="tcard__arrow" />
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
