---
// A small rounded-square photo with a gradient frame (the author box under posts).
// The full profile is the Maker ID badge in IdCard.astro.
import { existsSync } from 'node:fs';
import { siteConfig } from '../site.config';

const photo = siteConfig.authorPhoto;
const webp = photo && photo.replace(/\.(jpe?g|png)$/i, '.webp');
const hasWebp = webp && webp !== photo && existsSync(`public${webp}`);
---

{
  photo && (
    <figure class="avatar-sq">
      <picture>
        {hasWebp && <source srcset={webp} type="image/webp" />}
        <img src={photo} alt={siteConfig.author} width="800" height="800" loading="lazy" decoding="async" />
      </picture>
    </figure>
  )
}
