---
// The profile as a "Maker ID" badge: lanyard slot, rounded photo, certifications and a barcode strip.
// It tilts toward the pointer with a holographic sheen (src/scripts/motion.ts).
import { existsSync } from 'node:fs';
import { siteConfig } from '../site.config';
import Logo from './Logo.astro';

interface Props {
  /** Load the photo right away (above the fold). */
  eager?: boolean;
}

const { eager = false } = Astro.props;
const photo = siteConfig.authorPhoto;
const webp = photo && photo.replace(/\.(jpe?g|png)$/i, '.webp');
const hasWebp = webp && webp !== photo && existsSync(`public${webp}`);
const initials = siteConfig.author
  .split(/\s+/)
  .map((w) => w[0])
  .join('');
const top = siteConfig.authorCerts.at(-1);
const [city, country] = siteConfig.authorLocation.split(',').map((s) => s.trim());

// A barcode drawn from the letters of the name: same name, same bars.
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const ch of siteConfig.author.replace(/\s+/g, '').toUpperCase()) {
  const code = ch.charCodeAt(0);
  for (const w of [1 + (code % 3), 1 + ((code >> 2) % 2)]) {
    bars.push({ x, w });
    x += w + 1 + ((code >> 1) % 2);
  }
}
---

<div class="idcard" data-tilt>
  <div class="idcard__body">
    <span class="idcard__slot" aria-hidden="true"></span>
    <div class="idcard__top">
      <Logo />
      <span class="idcard__brand">Maker<i>/</i>Toolkit</span>
      <span class="idcard__tag">Maker ID</span>
    </div>
    <div class="idcard__photo">
      {
        photo ? (
          <picture>
            {hasWebp && <source srcset={webp} type="image/webp" />}
            <img src={photo} alt={siteConfig.author} width="800" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async" />
          </picture>
        ) : (
          <span class="idcard__initials" role="img" aria-label={siteConfig.author}>
            {initials}
          </span>
        )
      }
      {top && <span class="idcard__stamp">{top.code}</span>}
    </div>
    <p class="idcard__name">{siteConfig.author}</p>
    <p class="idcard__role">{siteConfig.authorRole.replace(/^Microsoft /, '')}</p>
    <ul class="idcard__certs" aria-label="Microsoft certifications">
      {siteConfig.authorCerts.map((c) => <li title={`Microsoft Certified: ${c.name}`}>{c.code}</li>)}
    </ul>
    <div class="idcard__foot">
      <svg class="idcard__barcode" viewBox={`0 0 ${x} 24`} preserveAspectRatio="none" aria-hidden="true">
        {bars.map((b) => <rect x={b.x} width={b.w} height="24" />)}
      </svg>
      <span class="idcard__loc">{city}{country && ` · ${country === 'India' ? 'IN' : country}`}</span>
    </div>
  </div>
  <span class="idcard__shine" aria-hidden="true"></span>
</div>
