---
// The full reference page: header, interactive explorer, how-to, A–Z index and FAQ.
import Base from '../layouts/Base.astro';
import ReferenceExplorer from './ReferenceExplorer';
import { slugify, type Reference } from '../data/types';

interface Props {
  reference: Reference;
}

const { reference: ref } = Astro.props;
const basePath = `/${ref.slug}/`;

const byLetter = Object.entries(
  ref.items.reduce<Record<string, typeof ref.items>>((acc, item) => {
    const l = item.name[0].toUpperCase();
    (acc[l] ??= []).push(item);
    return acc;
  }, {}),
);
---

<Base title={ref.title} description={ref.description} image={`/og/${ref.slug}.png`}>
  <div class="wrap wrap--wide">
    <header class="page-head">
      <p class="kicker"><b>Reference</b> · {ref.kicker}</p>
      <h1>{ref.title}</h1>
      <p class="page-head__lede">{ref.description}</p>
      <p class="page-head__meta">
        <span><b>{ref.items.length}</b> {ref.noun}</span>
        <span><b>{ref.categories.length}</b> categories</span>
        <span>Press <kbd>/</kbd> to search</span>
      </p>
    </header>

    <ReferenceExplorer
      client:load
      items={ref.items}
      categories={ref.categories}
      docsBase={ref.docsBase}
      basePath={basePath}
      noun={ref.noun}
      singular={ref.singular}
      lang={ref.language}
      placeholder={ref.searchPlaceholder}
    />
  </div>

  <section class="wrap section" aria-labelledby="howto-title">
    <div class="section-head">
      <div>
        <p class="kicker">Guide</p>
        <h2 id="howto-title">How to use this reference</h2>
      </div>
    </div>
    <ol class="steps">
      <li>
        <h3>Search or browse</h3>
        <p>Type a name or a task. Narrow it down with the A–Z strip or a category.</p>
      </li>
      <li>
        <h3>Open a card</h3>
        <p>See the syntax, what each part means, real examples and the gotchas makers run into.</p>
      </li>
      <li>
        <h3>Copy it in</h3>
        <p>
          {
            ref.language === 'wdl'
              ? 'Copy the syntax or an example, paste it into the Expression tab in your flow, and rename the actions.'
              : 'Copy the syntax or an example, paste it into the Power Apps formula bar, and rename the controls.'
          }
        </p>
      </li>
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="az-title">
    <div class="section-head">
      <div>
        <p class="kicker">Index</p>
        <h2 id="az-title">Every {ref.singular}, A–Z</h2>
      </div>
      <p>Each one also has its own page that you can bookmark or share.</p>
    </div>
    <div class="az-index">
      {
        byLetter.map(([letter, group]) => (
          <section aria-label={letter}>
            <h3>{letter}</h3>
            <ul>
              {group.map((item) => (
                <li>
                  <a href={`${basePath}${slugify(item.name)}/`}>{item.name}</a> <span>· {item.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="wrap section" aria-labelledby="rfaq-title">
    <div class="section-head">
      <div>
        <p class="kicker">Questions</p>
        <h2 id="rfaq-title">FAQ</h2>
      </div>
    </div>
    <div class="faq">
      {
        ref.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div>{f.a}</div>
          </details>
        ))
      }
    </div>
    <p class="note-box" style="margin-top:2rem">
      Descriptions on this site are written independently and simplified for makers. Always check the linked Microsoft
      Learn page for the complete, current behavior.
    </p>
  </section>
</Base>
