---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <article class="wrap prose">
    <p class="kicker"><b>Error</b> · 404</p>
    <h1>
      <code data-scramble>LookUp(Pages, URL = ThisURL)</code>
    </h1>
    <p class="lede">…returned blank. That page doesn't exist, or it moved.</p>
    <p style="margin-top:2rem">
      <a class="btn" href="/">Back to the toolbox</a>
    </p>
  </article>
</Base>
