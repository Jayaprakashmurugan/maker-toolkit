---
import Base from '../../layouts/Base.astro';
import ReferenceExplorer from '../../components/ReferenceExplorer';
import { powerAppsReference as ref } from '../../data/tools';
import { slugify } from '../../data/types';

const basePath = `/${ref.slug}/`;

const byLetter = Object.entries(
  ref.items.reduce<Record<string, typeof ref.items>>((acc, item) => {
    const l = item.name[0].toUpperCase();
    (acc[l] ??= []).push(item);
    return acc;
  }, {}),
);

const faqs = [
  {
    q: 'Which apps do these formulas work in?',
    a: 'Canvas apps in Power Apps. Many also work in other Power Fx hosts such as Copilot Studio and Dataverse formula columns, but check the official page for each host.',
  },
  {
    q: 'What does "delegable" mean?',
    a: 'A delegable formula is run by the data source itself, so it can work across all of your records. A non-delegable one only sees the first 500 records by default (up to 2,000 if you raise the limit in settings).',
  },
  {
    q: 'Why do some examples use names like txtSearch or colCart?',
    a: 'They follow a common naming convention: txt for text inputs, dd for dropdowns, col for collections and var for variables. Swap in your own control and data names.',
  },
];
---

<Base title={ref.title} description={ref.description}>
  <div class="wrap wrap--wide">
    <header class="page-head">
      <p class="kicker"><b>Reference</b> · Power Fx · Canvas apps</p>
      <h1>{ref.title}</h1>
      <p class="page-head__lede">{ref.description}</p>
      <p class="page-head__meta">
        <span><b>{ref.items.length}</b> formulas</span>
        <span><b>{ref.categories.length}</b> categories</span>
        <span>Press <kbd>/</kbd> to search</span>
      </p>
    </header>

    <ReferenceExplorer
      client:load
      items={ref.items}
      categories={ref.categories}
      docsBase={ref.docsBase}
      basePath={basePath}
    />
  </div>

  <section class="wrap section" aria-labelledby="howto-title">
    <div class="section-head">
      <div>
        <p class="kicker">Guide</p>
        <h2 id="howto-title">How to use this reference</h2>
      </div>
    </div>
    <ol class="steps">
      <li>
        <h3>Search or browse</h3>
        <p>Type a formula name or a task. Narrow it down with the A–Z strip or a category.</p>
      </li>
      <li>
        <h3>Open a card</h3>
        <p>See the syntax, what each parameter means, real examples and the gotchas makers run into.</p>
      </li>
      <li>
        <h3>Copy it in</h3>
        <p>Copy the syntax or an example, paste it into the Power Apps formula bar, and rename the controls.</p>
      </li>
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="az-title">
    <div class="section-head">
      <div>
        <p class="kicker">Index</p>
        <h2 id="az-title">Every formula, A–Z</h2>
      </div>
      <p>Each formula also has its own page that you can bookmark or share.</p>
    </div>
    <div class="az-index">
      {
        byLetter.map(([letter, group]) => (
          <section aria-label={letter}>
            <h3>{letter}</h3>
            <ul>
              {group.map((item) => (
                <li>
                  <a href={`${basePath}${slugify(item.name)}/`}>{item.name}</a> <span>· {item.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="wrap section" aria-labelledby="rfaq-title">
    <div class="section-head">
      <div>
        <p class="kicker">Questions</p>
        <h2 id="rfaq-title">FAQ</h2>
      </div>
    </div>
    <div class="faq">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div>{f.a}</div>
          </details>
        ))
      }
    </div>
    <p class="note-box" style="margin-top:2rem">
      Descriptions on this site are written independently and simplified for makers. Always check the linked Microsoft
      Learn page for the complete, current behavior.
    </p>
  </section>
</Base>
