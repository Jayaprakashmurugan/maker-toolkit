---
// Section heading: a code-comment index ("// 01") over a large title, with an optional "see all" link.
import Icon from './Icon.astro';

interface Props {
  title: string;
  id: string;
  /** Shown above the title as a code comment, e.g. "01 · tools". */
  index?: string;
  more?: { href: string; label: string };
}

const { title, id, index, more } = Astro.props;
---

<div class="shead" data-reveal>
  <div>
    {index && <p class="shead__idx">// {index}</p>}
    <h2 class="shead__title" id={id}>
      {title.split('/').map((part, i) => (i > 0 ? <>/<wbr />{part}</> : part))}
    </h2>
  </div>
  {
    more && (
      <a class="shead__more" href={more.href}>
        {more.label} <Icon name="arrow" />
      </a>
    )
  }
</div>
