---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import SectionHead from '../components/SectionHead.astro';
import ToolBrowser from '../components/ToolBrowser.astro';
import PostGrid from '../components/PostGrid.astro';
import VideoGrid from '../components/VideoGrid.astro';
import Icon from '../components/Icon.astro';
import { tools } from '../data/tools';
import { videos } from '../data/videos';
import { desktopReference, powerAppsReference, powerAutomateReference } from '../data/references';
import { getPosts } from '../lib/posts';
import { siteConfig } from '../site.config';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const entries = powerAppsReference.items.length + powerAutomateReference.items.length + desktopReference.items.length;
const toolCount = tools.filter((t) => t.kind === 'tool').length;
const tryThese = ['remove duplicates', 'format date', 'Patch', 'trigger condition', 'regex'];
const firstName = siteConfig.author.split(' ')[0];

const faqs = [
  {
    q: 'Is it free?',
    a: 'Yes. Every tool runs in your browser. There is no account, no paywall and nothing to install.',
  },
  {
    q: 'Do you collect my data?',
    a: 'No. There are no cookies and no sign-ups. Nothing you type into a tool leaves your device.',
  },
  {
    q: 'Is this an official Microsoft site?',
    a: 'No. It is an independent project. Every reference entry links to the official Microsoft Learn page so you can check the source.',
  },
  {
    q: 'Something is wrong or missing. What do I do?',
    a: 'Report it on the issues page linked from the Contact page. Corrections and suggestions are welcome.',
  },
];
---

<Base description={siteConfig.description}>
  <section class="wrap hero2">
    <div class="hero2__photo reveal" style="--d:0">
      <Portrait />
    </div>
    <div class="hero2__text">
      <p class="hero2__by reveal" style="--d:1">
        By <a href="/about/">{siteConfig.author}</a> · {siteConfig.authorRole.replace(/^Microsoft /, '')}
      </p>
      <h1 class="hero2__title reveal" style="--d:2">
        Maker <span class="grad-text" data-scramble>Toolkit</span>
      </h1>
      <p class="hero2__lede reveal" style="--d:3">
        Free tools, guides and videos for <b>Power Apps</b>, <b>Power Automate</b> and <b>Dataverse</b> makers.
        Search {entries} formulas or pick a tool. Everything runs in your browser.
      </p>
      <div class="hero2__actions reveal" style="--d:4">
        <a class="btn btn--lg" href="/tools/">Explore tools <Icon name="arrow" /></a>
        <a class="btn btn--outline btn--lg" href="/about/">About me</a>
      </div>
      <form class="hero-search reveal" style="--d:5" role="search" action="/" data-search-form>
        <label class="visually-hidden" for="hero-q">Search tools, formulas and expressions</label>
        <Icon name="search" />
        <input id="hero-q" type="search" placeholder="Search tools, formulas, expressions…" autocomplete="off" spellcheck="false" data-search-input />
        <kbd data-search-kbd>Ctrl K</kbd>
      </form>
      <p class="hero-search__try reveal" style="--d:5">
        Try
        {
          tryThese.map((q) => (
            <button type="button" class="chip" data-search-query={q}>
              {q}
            </button>
          ))
        }
      </p>
    </div>
  </section>

  <section class="wrap">
    <dl class="hstats" data-reveal-group>
      <div><dt>Power Fx formulas</dt><dd data-count>{powerAppsReference.items.length}</dd></div>
      <div><dt>Flow expressions</dt><dd data-count>{powerAutomateReference.items.length}</dd></div>
      <div><dt>Desktop formulas</dt><dd data-count>{desktopReference.items.length}</dd></div>
      <div><dt>Free tools</dt><dd data-count>{toolCount}</dd></div>
      <div><dt>Cookies</dt><dd>0</dd></div>
    </dl>
  </section>

  <section class="wrap home-section" id="tools" aria-labelledby="h-tools">
    <SectionHead icon="tools" title="Tools" id="h-tools" more={{ href: '/tools/', label: 'All tools' }} />
    <ToolBrowser />
  </section>

  {
    posts.length > 0 && (
      <section class="wrap home-section" aria-labelledby="h-posts">
        <SectionHead icon="blog" title="Latest blog posts" id="h-posts" more={{ href: '/blog/', label: 'All posts' }} />
        <PostGrid posts={posts.slice(0, 3)} />
      </section>
    )
  }

  {
    videos.length > 0 && (
      <section class="wrap home-section" aria-labelledby="h-videos">
        <SectionHead icon="video" title="Latest videos" id="h-videos" more={{ href: '/videos/', label: 'All videos' }} />
        <VideoGrid videos={videos.slice(0, 3)} />
      </section>
    )
  }

  <section class="wrap home-section" aria-labelledby="h-about">
    <SectionHead icon="user" title="Who builds this" id="h-about" />
    <div class="intro-card" data-reveal>
      <Portrait size="md" badge={false} />
      <div>
        <p class="intro-card__name">Hi, I'm {firstName}.</p>
        <p class="intro-card__bio">{siteConfig.authorBio}</p>
        <ul class="pills" aria-label="Certifications">
          {siteConfig.authorCerts.map((c) => <li class="pill"><Icon name="award" /> {c.code}</li>)}
          <li class="pill"><Icon name="pin" /> {siteConfig.authorLocation}</li>
        </ul>
        <p class="intro-card__links">
          <a class="btn btn--outline" href="/about/">More about me <Icon name="arrow" /></a>
          <a class="btn btn--outline" href="/contact/">Get in touch</a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap home-section" aria-labelledby="faq-title">
    <SectionHead icon="chat" title="Questions" id="faq-title" />
    <div class="faq" data-reveal-group>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div>{f.a}</div>
          </details>
        ))
      }
    </div>
  </section>
</Base>
