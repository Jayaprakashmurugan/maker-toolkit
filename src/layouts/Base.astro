---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { siteConfig } from '../site.config';
import Logo from '../components/Logo.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { categories, tools, toolsIn } from '../data/tools';
import { videos } from '../data/videos';
import { getPosts } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  /** Share image path, e.g. "/og/about.png". */
  image?: string;
}

const { title, description = siteConfig.description, image = '/og/home.png' } = Astro.props;
const fullTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname;
const words = siteConfig.name.split(/\s+/);

// Blog and Videos appear in the menu once there's something to show.
const hasPosts = (await getPosts()).some((p) => !p.data.draft);
const toolPaths = ['/tools/', ...categories.map((c) => `/${c.id}/`), ...tools.map((t) => t.href)];
const postCount = (await getPosts()).filter((p) => !p.data.draft).length;
const nav: { href: string; label: string; count?: number; match: string[] }[] = [
  { href: '/tools/', label: 'Tools', count: tools.length, match: toolPaths },
  ...(hasPosts ? [{ href: '/blog/', label: 'Blog', count: postCount, match: [] }] : []),
  ...(videos.length ? [{ href: '/videos/', label: 'Videos', count: videos.length, match: [] }] : []),
  { href: '/about/', label: 'About', match: [] },
  { href: '/contact/', label: 'Contact', match: [] },
];
const isCurrent = (n: (typeof nav)[number]) => (n.href === '/' ? path === '/' : [n.href, ...n.match].some((h) => path.startsWith(h)));
const socials = [...siteConfig.authorLinks, ...(siteConfig.youtubeUrl ? [{ label: 'YouTube', href: siteConfig.youtubeUrl, icon: 'youtube' }] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    {
      siteConfig.googleSiteVerification && (
        <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
      )
    }
    <meta name="theme-color" content="#07090d" />
    <script is:inline>
      // Dark is the default; apply a saved choice before first paint to avoid a flash.
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
      // Enable entrance animations unless the visitor prefers reduced motion.
      // Safety net: if the motion script never runs, show everything after 2.5 s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 2500);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="bg" aria-hidden="true">
      <div class="bg__aurora"></div>
      <div class="bg__grid"></div>
      <div class="bg__grain"></div>
    </div>

    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
          <Logo />
          <span class="brand__text">
            {words.map((w, i) => (
              <>
                {i > 0 && <span class="brand__slash">/</span>}
                {w}
              </>
            ))}
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>
                {n.label}
                {n.count !== undefined && <sup aria-hidden="true">{n.count}</sup>}
              </a>
            ))
          }
        </nav>
        <div class="site-tools">
          <button type="button" class="search-btn" data-search-open aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
            <Icon name="search" />
            <span class="search-btn__label">Search</span>
            <kbd data-search-kbd>Ctrl K</kbd>
          </button>
          <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Switch between dark and light">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" class="icon-btn menu-btn" popovertarget="mobile-nav" aria-label="Menu">
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" popover aria-label="Menu">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        {
          nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>
              {n.label}
              {n.count !== undefined && <sup aria-hidden="true">{n.count}</sup>}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-mark" aria-hidden="true">
        <div class="footer-mark__track">
          {
            Array.from({ length: 4 }, (_, i) => (
              <span class:list={{ 'is-outline': i % 2 === 1 }}>
                Maker<i>/</i>Toolkit
              </span>
            ))
          }
        </div>
      </div>
      <div class="wrap wrap--wide site-footer__inner">
        <div class="site-footer__about">
          <a class="brand" href="/">
            <Logo />
            <span>{siteConfig.name}</span>
          </a>
          <p class="site-footer__by">Free tools, guides and videos by {siteConfig.author}.</p>
          <p class="social">
            {
              socials.map((s) => (
                <a href={s.href} rel="noopener me" aria-label={s.label} title={s.label}>
                  <Icon name={s.icon as IconName} />
                </a>
              ))
            }
          </p>
        </div>
        <nav class="footer-cols" aria-label="Footer">
          {
            categories.map((c) => (
              <div>
                <a class="footer-cols__head" href={`/${c.id}/`}>
                  {c.name}
                </a>
                <ul>
                  {toolsIn(c.id).map((t) => (
                    <li>
                      <a href={t.href}>{t.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div>
            <span class="footer-cols__head">Site</span>
            <ul>
              {hasPosts && <li><a href="/blog/">Blog</a></li>}
              {videos.length > 0 && <li><a href="/videos/">Videos</a></li>}
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/changelog/">What’s new</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="wrap wrap--wide site-footer__bottom">
        <p>© {new Date().getFullYear()} {siteConfig.author}</p>
        <p class="site-footer__legal">
          <a href="/privacy/">Privacy &amp; terms</a>
          <a href={siteConfig.feedbackUrl} rel="noopener">Report an issue</a>
        </p>
        <p class="disclaimer">
          Independent project, not affiliated with Microsoft. Power Apps, Power Automate, Power Fx, Dataverse and
          SharePoint are trademarks of Microsoft Corporation. Product icons are Microsoft's official Power Platform
          icons, shown only to indicate which product each tool works with.
        </p>
      </div>
    </footer>

    <dialog class="sitesearch" id="site-search" aria-label="Search the site">
      <div class="sitesearch__bar">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input
          id="search-q"
          type="search"
          placeholder="Search tools, formulas, expressions…"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-expanded="true"
          aria-controls="search-results"
          aria-autocomplete="list"
          aria-label="Search"
        />
        <button type="button" class="sitesearch__close" data-search-close aria-label="Close search">Esc</button>
      </div>
      <ul id="search-results" class="sitesearch__results" role="listbox" aria-label="Results"></ul>
      <p class="sitesearch__foot">
        <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
        <span><kbd>Enter</kbd> open</span>
        <span class="sitesearch__count" aria-live="polite"></span>
      </p>
    </dialog>

    <div id="sr-status" class="visually-hidden" aria-live="polite"></div>

    {
      siteConfig.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: siteConfig.cfAnalyticsToken })}
        />
      )
    }

    <script>
      import '../scripts/motion';
      import '../scripts/search';

      // One delegated handler for every copy button, including ones React renders later.
      const status = document.getElementById('sr-status');

      async function copyText(text: string) {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
      }

      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy]');
        if (!btn) return;
        await copyText(btn.dataset.copy ?? '');
        btn.classList.add('is-copied');
        if (status) status.textContent = 'Copied to clipboard';
        window.setTimeout(() => {
          btn.classList.remove('is-copied');
          if (status) status.textContent = '';
        }, 1600);
      });

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'light') root.dataset.theme = 'light';
        else delete root.dataset.theme;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
