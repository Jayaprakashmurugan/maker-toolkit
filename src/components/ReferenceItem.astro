---
// One page per formula/expression, with its own URL for search engines and sharing.
import Base from '../layouts/Base.astro';
import FormulaDetail from './FormulaDetail';
import { slugify, type Reference, type RefItem } from '../data/types';

interface Props {
  reference: Reference;
  item: RefItem;
  prev: RefItem | null;
  next: RefItem | null;
}

const { reference: ref, item, prev, next } = Astro.props;
const basePath = `/${ref.slug}/`;
const slug = slugify(item.name);
const color = ref.categories.find((c) => c.name === item.category)?.color;
const related = ref.items.filter((i) => i.category === item.category && i.name !== item.name);
const jsonRelated =
  ref.language === 'wdl' &&
  (item.category === 'JSON & XML' || ['json', 'body', 'triggerBody', 'outputs', 'item', 'items'].includes(item.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${item.name} function (${ref.product})`,
  description: item.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base
  title={`${item.name} function · ${ref.product}`}
  description={`${item.summary} Syntax: ${item.syntax}`}
  image={`/og/${ref.slug}/${slug}.png`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap" style={`--cat:${color}`}>
    <header class="formula-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href={basePath}>{ref.title}</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{item.name}</span>
      </nav>
      <span class="tag"><span class="chip__dot" aria-hidden="true"></span>{item.category}</span>
      <h1 data-scramble>{item.name}</h1>
      <p>{item.summary}</p>
    </header>

    <div class="formula-layout">
      <article>
        <FormulaDetail item={item} docsBase={ref.docsBase} lang={ref.language} level={2} />

        <nav class="pager" aria-label={`Previous and next ${ref.singular}`}>
          {
            prev ? (
              <a href={`${basePath}${slugify(prev.name)}/`}>
                <small>← Previous</small>
                <strong>{prev.name}</strong>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`${basePath}${slugify(next.name)}/`}>
                <small>Next →</small>
                <strong>{next.name}</strong>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="formula-aside">
        <div class="aside-card aside-card--cta">
          <h2>Explorer</h2>
          <p>Browse all {ref.items.length} {ref.noun} with search, A–Z and categories.</p>
          <a class="btn" href={`${basePath}?f=${encodeURIComponent(item.name)}`}>Open in explorer →</a>
        </div>
        {
          jsonRelated && (
            <div class="aside-card">
              <h2>Parsing JSON?</h2>
              <p class="aside-card__text">Get a Parse JSON schema that won’t fail on nulls, plus an expression for every field.</p>
              <a href="/json-schema-helper/">JSON Schema Helper →</a>
            </div>
          )
        }
        {
          ref.language === 'wdl' && (
            <div class="aside-card">
              <h2>Long expression?</h2>
              <p class="aside-card__text">Paste it into the beautifier to indent it and check the brackets.</p>
              <a href="/expression-beautifier/">Expression Beautifier →</a>
            </div>
          )
        }
        {
          related.length > 0 && (
            <div class="aside-card">
              <h2>More in {item.category}</h2>
              <div class="related">
                {related.map((r) => (
                  <a class="related__item" href={`${basePath}${slugify(r.name)}/`}>
                    {r.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Base>
